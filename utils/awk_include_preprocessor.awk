#!/usr/bin/awk -f
# AWK Include Preprocessor
# Never uses getline for file existence checks

BEGIN {
    if (basedir == "") basedir = "."
    if (ARGV[1] == "") {
        print "Usage: awk -f awk_include_preprocessor.awk -v basedir=DIR input.awk" > "/dev/stderr"
        exit 1
    }
    
    input_file = ARGV[1]
    ARGV[1] = ""
    
    print "# Auto-generated by awk_include_preprocessor.sh"
    print "#"
    
    # Initialization
    processed_count = 0
    
    # Process main file
    process_file(input_file, basedir)
}

# Proper file existence check via system()
function file_exists(path,    cmd, result) {
    cmd = "test -f \"" path "\" && echo 1 || echo 0"
    cmd | getline result
    close(cmd)
    return (result == "1")
}

# Get canonical path via shell realpath or readlink
function get_canonical_path(path,    cmd, result) {
    # Try realpath (GNU/Linux)
    cmd = "realpath \"" path "\" 2>/dev/null || readlink -f \"" path "\" 2>/dev/null || echo \"" path "\""
    cmd | getline result
    close(cmd)
    return result
}

# Normalize path (remove ./ and ../)
function normalize_path(path,    parts, n, i, j, normalized, result) {
    n = split(path, parts, "/")
    j = 0
    for (i = 1; i <= n; i++) {
        if (parts[i] == "." || parts[i] == "") continue
        if (parts[i] == ".." && j > 0) {
            j--
            continue
        }
        normalized[++j] = parts[i]
    }
    
    result = (substr(path, 1, 1) == "/" ? "/" : "")
    for (i = 1; i <= j; i++) {
        result = result (i > 1 ? "/" : "") normalized[i]
    }
    return result
}

# Resolve file path
function resolve_file(inc_path, base_dir,    file, test_path, dirs, n, i) {
    # Remove quotes
    gsub(/^[" ']|[" ']$/, "", inc_path)
    
    # Try different paths
    if (file_exists(inc_path)) {
        file = normalize_path(inc_path)
        if (substr(file, 1, 1) != "/")
            file = get_canonical_path(inc_path)
        return file
    }
    
    test_path = base_dir "/" inc_path
    if (file_exists(test_path)) {
        file = normalize_path(test_path)
        if (substr(file, 1, 1) != "/")
            file = get_canonical_path(test_path)
        return file
    }
    
    # Try AWKPATH
    if (ENVIRON["AWKPATH"] != "") {
        n = split(ENVIRON["AWKPATH"], dirs, ":")
        for (i = 1; i <= n; i++) {
            test_path = dirs[i] "/" inc_path
            if (file_exists(test_path)) {
                return normalize_path(test_path)
            }
        }
    }
    
    return ""
}

# Process file - CORRECT version
function process_file(filepath, base_dir,    canonical, line, inc_path, resolved, file_base, parts, n, i) {
    # Resolve path (may be relative)
    if (substr(filepath, 1, 1) == "/") {
        # Absolute path
        canonical = normalize_path(filepath)
    } else {
        # Relative - try to find
        canonical = resolve_file(filepath, base_dir)
        if (canonical == "") {
            print "# ERROR: File not found: " filepath > "/dev/stderr"
            return
        }
    }
    
    # Check that file exists
    if (!file_exists(canonical)) {
        print "# ERROR: File not found: " canonical > "/dev/stderr"
        return
    }
    
    # Check if already processed
    if (canonical in processed_files) {
        print "# Skipping already included: " filepath
        return
    }
    processed_files[canonical] = 1
    
    print "# BEGIN: " filepath
    
    # Get base directory for this file
    n = split(canonical, parts, "/")
    file_base = ""
    for (i = 1; i < n; i++) {
        file_base = file_base (i > 1 ? "/" : "") parts[i]
    }
    if (file_base == "") file_base = "."
    
    # Read and process file line by line
    # IMPORTANT: use getline ONLY for reading content
    while ((getline line < canonical) > 0) {
        # Check for @include
        if (match(line, /^[ \t]*@include[ \t]+/)) {
            # Extract path
            inc_path = line
            sub(/^[ \t]*@include[ \t]+/, "", inc_path)
            
            # Resolve and process recursively
            resolved = resolve_file(inc_path, file_base)
            if (resolved != "") {
                print "# @include expanded: " inc_path
                process_file(resolved, file_base)
            } else {
                print "# ERROR: Could not resolve: " inc_path
                print line
            }
        } else {
            # Regular line - print as is
            print line
        }
    }
    close(canonical)
    
    print "# END: " filepath
}
